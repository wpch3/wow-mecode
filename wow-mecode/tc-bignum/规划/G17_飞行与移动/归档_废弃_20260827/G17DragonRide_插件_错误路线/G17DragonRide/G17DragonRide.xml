<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Frame name="G17DragonRideFrame" toplevel="true" enableMouse="true" movable="true" hidden="true" frameStrata="HIGH">
		<Size><AbsDimension x="368" y="168"/></Size>
		<Anchors>
			<Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="132"/></Offset></Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Gold-Border" tile="true">
			<BackgroundInsets><Inset left="8" right="8" top="8" bottom="8"/></BackgroundInsets>
			<TileSize><AbsDimension x="32" y="32"/></TileSize>
			<EdgeSize><AbsDimension x="16" y="16"/></EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentTitle" inherits="GameFontNormalSmall" text="G17 御龙术 · 专属界面">
					<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-7"/></Offset></Anchor></Anchors>
				</FontString>
				<FontString name="$parentPage" inherits="GameFontGreenSmall" text="">
					<Anchors><Anchor point="TOPRIGHT"><Offset><AbsDimension x="-12" y="-7"/></Offset></Anchor></Anchors>
				</FontString>
				<FontString name="$parentWarn" inherits="GameFontRedSmall" text="">
					<Anchors><Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="5"/></Offset></Anchor></Anchors>
				</FontString>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentEnergyBg" file="Interface\TargetingFrame\UI-StatusBar">
					<Size><AbsDimension x="330" y="10"/></Size>
					<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-22"/></Offset></Anchor></Anchors>
					<Color r="0.1" g="0.1" b="0.1" a="0.9"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<StatusBar name="$parentEnergyBar">
				<Size><AbsDimension x="330" y="10"/></Size>
				<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-22"/></Offset></Anchor></Anchors>
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
				<BarColor r="0.2" g="0.8" b="1.0"/>
			</StatusBar>
		</Frames>
		<Scripts>
			<OnLoad>G17DragonRide_OnLoad(self);</OnLoad>
			<OnEvent>G17DragonRide_OnEvent(self, event, ...);</OnEvent>
			<OnUpdate>G17DragonRide_OnUpdate(self, elapsed);</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
